# Install inside the http context, after configuring TLS certificates for your actual domain.
limit_req_zone $binary_remote_addr zone=archy_accounts:10m rate=10r/m;

server {
    listen 443 ssl;
    server_name archy.example.com;
    ssl_certificate /etc/letsencrypt/live/archy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/archy.example.com/privkey.pem;
    client_max_body_size 21m;

    location ~ ^/api/auth/(login|signup|password-reset|reset-password|demo)$ {
        limit_req zone=archy_accounts burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
        add_header Cache-Control "private, no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
